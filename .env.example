# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Neon. Dos URLs distintas:
#   DATABASE_URL         -> la que usa la app. En producción, el endpoint con "-pooler".
#   DIRECT_DATABASE_URL  -> el mismo host SIN "-pooler". Úsala en local y para
#                           correr migraciones; el pooler en modo transacción
#                           da problemas con migraciones largas.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Stripe: SIEMPRE en modo test. Las llaves deben empezar por pk_test_ / sk_test_.
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONEDA=cop
